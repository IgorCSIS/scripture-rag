# Copy to .env and edit. Never commit .env.
EMBED_MODEL=hashing             # or intfloat/multilingual-e5-small, BAAI/bge-small-en-v1.5, sentence-transformers/all-MiniLM-L6-v2, BAAI/bge-m3
RERANK_MODEL=lexical            # or cross-encoder/ms-marco-MiniLM-L-6-v2, BAAI/bge-reranker-v2-m3
REFUSAL_THRESHOLD=0.5
MAX_UPLOAD_MB=50
MAX_PAGES=2000
PARSE_TIMEOUT_S=60
CHUNK_TOKENS=400
CHUNK_OVERLAP=60
